# Supabase — frontend (Vite) config.
# Both values are safe to ship to the browser: the anon key is a public,
# RLS-scoped key. NEVER put SUPABASE_SECRET_KEY / service_role here — any
# VITE_-prefixed var is inlined into the JS bundle.
#
# Find them in: Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
